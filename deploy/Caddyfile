# FOMO Robinhood Radar
#
# One canonical host, fomoradar.app. Caddy fetches and renews the certificate on its own; nothing
# here has to know about Let's Encrypt.
#
# `.app` is on the HSTS preload list, which means browsers refuse to speak plain HTTP to it at all.
# That is a feature and it has one consequence worth remembering: until the certificate exists the
# domain does not load, and that reads exactly like a broken server.

fomoradar.app {
	encode zstd gzip

	# An address that asked 52,000 times in one hour with the bare "node" user agent and took
	# 29,000 refusals is not a client, it is a loop. Refused here, before it reaches the API.
	# Add to the list as they turn up; the API's own limiter handles everyone else.
	@abuser remote_ip 34.186.82.14
	respond @abuser 429

	# the API and its generated documentation
	handle /api/* {
		reverse_proxy 127.0.0.1:8000
	}
	handle /docs* {
		reverse_proxy 127.0.0.1:8000
	}
	handle /redoc* {
		reverse_proxy 127.0.0.1:8000
	}
	handle /openapi.json {
		reverse_proxy 127.0.0.1:8000
	}

	# everything else is the server-rendered site
	handle {
		reverse_proxy 127.0.0.1:4321
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
		-Server
	}

	# Access logs go to journald, which the packaged unit already has write access to and
	# which rotates them for free. `journalctl -u caddy` reads them back.
	log {
		format json
	}
}

# Everything that is not the canonical host is sent to it. Two addresses serving the same pages
# would split every inbound link and give search engines two of everything to choose between —
# and the canonical tag in the HTML says fomoradar.app, so the server should agree with it.
www.fomoradar.app {
	redir https://fomoradar.app{uri} permanent
}

# The bare IP kept working for months and people have it. It answers, and then it moves them on.
# the bare address, so a link typed without the domain still lands on it
http://YOUR.SERVER.IP {
	redir https://fomoradar.app{uri} permanent
}
