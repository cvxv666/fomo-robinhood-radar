# --- keys ---
HELIUS_API_KEY=
ANTHROPIC_API_KEY=
# optional: Codex (defined.fi data). $1 one-time 'Almost Free' plan, 10k req/month. https://dashboard.codex.io/signup
CODEX_API_KEY=
# Session for fomo.family internal API (cookie string or bearer token).
# Obtain via: python scripts/capture_fomo_endpoints.py  (phase 0)
FOMO_SESSION=
# fomoapi.io - the fomo side over HTTP. Free key: 1,000 credits a month, the schedule spends ~30 a day
FOMOAPI_KEY=
FOMO_AUTH_KIND=cookie   # cookie | bearer
FOMO_BASE_URL=https://prod-api.fomo.family
FOMO_SUPPORTED_CHAINS=1399811149,4663,8453,56
# leaderboard rows whose execution wallet we resolve per run (1 request each, 1 req/s)
FOMO_RESOLVE_LIMIT=25
# inferring a fomo trader's real wallet from token events (1 Codex request per window)
RESOLVE_WINDOWS=12
RESOLVE_WINDOW_S=90
RESOLVE_MIN_HITS=3
RESOLVE_MIN_RATIO=1.4
RESOLVE_USERS_PER_PASS=20

# --- rhtrenches.com (third party, no key): fomo traders on Robinhood Chain ---
TRENCHES_BASE_URL=https://rhtrenches.com
TRENCHES_MIN_INTERVAL_S=900
# include tokenized stocks (GME, NVDA...) alongside memecoins
TRENCHES_INCLUDE_STOCKS=false
TRENCHES_WINDOW=7d

# --- local receiver for the browser extension (extension/) ---
RECEIVER_HOST=127.0.0.1
RECEIVER_PORT=8787
# optional shared secret; set the same value in the extension popup
RECEIVER_TOKEN=

# --- storage ---
DB_PATH=fomo_agent.db

# --- thresholds ---
NEW_TOKEN_MIN_MCAP_USD=500000
NEW_TOKEN_MAX_AGE_HOURS=24
# upper sanity cap (spoofed supply tokens show trillions)
NEW_TOKEN_MAX_MCAP_USD=1000000000
# pools with unknown/zero liquidity (bonding curves, dust) are dropped below this
NEW_TOKEN_MIN_LIQUIDITY_USD=10000
# DexScreener chainIds for the new-token trigger (tracking via Helius is solana-only)
DEX_CHAINS=robinhood
# where fresh tokens come from: dexscreener (needs profile/boost), geckoterminal (no boost, 30 rpm), codex (needs key; skipped silently without it)
TOKEN_SOURCES=dexscreener,geckoterminal,codex
# geckoterminal feeds per chain: trending_5m|trending_1h|trending_6h|trending_24h|top_volume|new|new_2
# 'new' = newest 20 pools (~2 min of history on solana, almost all dust); off by default
GECKO_FEEDS=trending_1h,trending_6h,top_volume
# GeckoTerminal allows 30 a minute per IP and counts every process on the box together; one
# window is kept in RATELIMIT_PATH (next to the DB by default) and shared by all of them. The
# reserve is the part kept for request threads (a chart on a token page); batch jobs wait on the rest
GECKO_MAX_REQ_PER_MIN=20
GECKO_RESERVE_PER_MIN=5
GECKO_MIN_INTERVAL_S=2.0
# RATELIMIT_PATH=/opt/fomoradar/ratelimit.db
# codex is polled at most once per this many seconds regardless of loop speed (budget guard)
CODEX_MIN_INTERVAL_S=900
# plan cap used by `init` to project monthly usage
CODEX_MONTHLY_REQUEST_CAP=10000
# true = ask Codex to hide potentialScam tokens. Aggressive: also hides some legit high-cap launches.
CODEX_EXCLUDE_POTENTIAL_SCAM=false
HOLDERS_TOP_N=30
# open positions are marked with a token's last price, so it is re-quoted when it goes stale.
# The two together set the cost: 400 addresses is ~14 DexScreener requests per collection pass.
PRICE_MAX_AGE_S=7200
PRICE_REFRESH_LIMIT=400
# codex discovery: buyers of the N biggest fresh tokens each pass become candidates (1 request per token)
DISCOVER_TOKENS_PER_PASS=3
DISCOVER_MIN_BUY_USD=500
LEADERBOARD_LIMIT=100

# --- intervals (seconds) ---
DISCOVER_INTERVAL=3600
NEW_TOKENS_INTERVAL=900
TRACK_INTERVAL=10800
REPORT_INTERVAL=86400

# --- public HTTP API (pip install -e ".[api]") ---
# bind to loopback and let a reverse proxy terminate TLS in front of it
API_HOST=127.0.0.1
API_PORT=8000
API_RATE_PER_MIN=120
# uvicorn worker processes (the cache and the limiter are per worker); the server runs 2
API_WORKERS=1
# seconds a GET answer is served from memory
API_CACHE_TTL_S=10
# leave empty to allow any origin; set to your site once it has a domain
API_CORS_ORIGINS=

# --- telegram bot (@BotFather -> /newbot) ---
TELEGRAM_BOT_TOKEN=
# long polling, so no webhook and no public address are needed
TELEGRAM_POLL_TIMEOUT=50
# the Bot API takes ~30 messages a second to different chats: the gap the bulk sends keep, and
# how long a 429 with no stated wait is waited out. The burst alerts go to every chat now
TELEGRAM_SEND_GAP_S=0.04
TELEGRAM_RETRY_AFTER_S=2
# only if api.telegram.org is blocked where you run this. http://host:port or socks5://host:port
TELEGRAM_PROXY=
# conviction floor for a pushed alert. 4.0 is roughly four wallets scoring 80 agreeing.
TELEGRAM_MIN_CONVICTION=4.0
# heat floor for a pushed launch. Measured on a live day: 1.0 is 28 messages, 2.0 is six, 3.0 three.
TELEGRAM_MIN_HEAT=2.0
# a launch is pushed only this many minutes after its first trusted buy; later it is history, not a push
TELEGRAM_LAUNCH_MAX_AGE_MIN=60
# how many of today's tokens the enrichment pass re-asks "can it be sold" about, every fifteen minutes
SELL_CHECK_PER_PASS=12
# the pool's silence as a witness: MIN_BUYS buys and not one sell after MIN_AGE_S is a no; the
# wait shrinks in proportion to the buys, down to FLOOR_S (8 buys wait 30 min, 48 wait 5)
SELL_SILENCE_MIN_BUYS=8
SELL_SILENCE_MIN_AGE_S=1800
SELL_SILENCE_FLOOR_S=300
# how far back a signal may reach to still count as "now"
TELEGRAM_ALERT_WINDOW_H=6
TELEGRAM_ALERT_INTERVAL_S=120
# never tell one chat about the same token twice inside this window
TELEGRAM_REALERT_HOURS=12

# --- bursts: conviction that arrived all at once (pipeline/hot.py) ---
# fires when this much conviction from this many trusted wallets, each making its first buy of the
# token, lands inside the window. Chosen by `fomo-radar hot --backtest` over the whole tape.
HOT_DELTA=4.0
HOT_WINDOW_MIN=30
HOT_MIN_WALLETS=3
# 0 = no age cap; nine in ten bursts are in a token's first hour and the age is shown instead
HOT_MAX_AGE_H=0

# --- the watcher: the chain every few seconds (pipeline/watch.py) ---
WATCH_POLL_S=20
# its own share of the RPC allowance, beside the fifteen-minute pass
WATCH_RPC_MAX_PER_MIN=15
WATCH_ROSTER_REFRESH_S=600
WATCH_START_BACK_BLOCKS=600
WATCH_MAX_RANGE_BLOCKS=6000
# a line in the journal every so often even when nothing fills, and its own shorter RPC timeout
WATCH_HEARTBEAT_S=300
WATCH_RPC_TIMEOUT_S=30

# --- whose trade a fill is (pipeline/provenance.py) ---
# a buy under max(the floor, this share of the wallet's own median buy) is dust: shown, not counted
DUST_ABS_USD=5
DUST_RATIO=0.02
# a token pushed into this many trusted wallets, more than bought it for real, leaves every feed
SEED_MIN_WALLETS=3
SEED_WINDOW_H=24

# --- fomoapi.io budget: a free key is 1,000 a month; the guard stops a pass before the 402 ---
FOMOAPI_MONTHLY_CREDITS=1000
FOMOAPI_THESIS_PAGES=1

# --- the site (site/): shown in canonical tags and the footer ---
PUBLIC_SITE_URL=https://fomoradar.app
# the footer's "source" link; empty hides it
PUBLIC_REPO_URL=https://github.com/cvxv666/fomo-robinhood-radar
# The token block under the home-page headline: the contract address with a copy button.
# Empty means no block at all. Set the address and deploy; the site rebuilds with it.
PUBLIC_TOKEN_CA=
# fomo.family referral: the code goes on every fomo link the bot, the site and the API hand out
FOMO_REF_CODE=
FOMO_REF_PARAM=ref
FOMO_REF_URL=
PUBLIC_TOKEN_SYMBOL=
# the bot's @name without the @, for links from the site's /pro page
TELEGRAM_BOT_NAME=fomoradarRH_bot

# --- X: the radar's own account (pipeline/xpost.py, sources/x.py) ---
# Off until the developer app exists and scripts/x_auth.py has written the token file. The app's
# OAuth 2.0 client id and (for a confidential client) secret; the token file is written by the
# script and rotated by the client - never put a token in here.
X_ENABLED=0
X_CLIENT_ID=
X_CLIENT_SECRET=
X_TOKEN_FILE=/opt/fomoradar/x_token.json
# X hears a push this long after Telegram (an hour: the bot is instant, X is the record), and
# at most this many posts a day
X_POST_DELAY_S=3600
X_MAX_PER_DAY=40

# --- PRO: the alerts and the live feeds, paid in the token and burned (pipeline/pro.py) ---
# 0 is no gate at all. Set the dollar price and deploy; the bot answers /pro with an exact amount.
PRO_PRICE_USD=0
PRO_DAYS=30
# paid in this token (empty: PUBLIC_TOKEN_CA) to this address; the burn is the receipt
PRO_TOKEN=
PRO_BURN_ADDRESS=0x000000000000000000000000000000000000dEaD
# a quote holds this long; a burn of exactly its amount up to six hours later still counts
PRO_QUOTE_TTL_MIN=30
# /claim accepts a burn this far under the dollar price (the price moved while it was in flight)
PRO_PRICE_TOLERANCE=0.03
# unix time: everyone subscribed before it stays on the free side until it (the launch grace)
PRO_GRACE_UNTIL=0
# days of PRO a new chat gets on /start; 0 is none
PRO_TRIAL_DAYS=0

# --- rate limits ---
FOMO_RPS=1.0
HELIUS_MAX_REQ_PER_MIN=50
# wallet-trade sources in priority order. rpc reads Robinhood Chain's own endpoint and covers the
# whole roster in two requests, free and keyless. trenches is free but only for the ~108 wallets it
# curates. codex works on every chain but spends 1+ request per wallet per pass. helius is
# solana-only and needs a key.
TRACK_SOURCES=rpc,trenches,codex,helius

# --- Robinhood Chain RPC (free, no key) ---
# spare endpoints, comma-separated: asked for a call the node rate-limited, one call at a
# time, never as a switch. A keyed dRPC free plan works (https://lb.drpc.live/robinhood/<key>):
# it answers head, eth_call and single receipts, refuses log ranges over ~100 blocks and
# batches, and those go back to waiting on the node.
RPC_URLS=
RPC_URL=https://rpc.mainnet.chain.robinhood.com
# the endpoint rejects the default httpx user agent with 403
# RPC_USER_AGENT=
# it 429s on bursts, and every 429 is retried with a backoff
RPC_MAX_PER_MIN=45
# calls per HTTP round trip when fetching receipts
RPC_BATCH_SIZE=40
# ~0.1s blocks. How far back the fifteen-minute pass re-reads. With the watcher running it is
# a gap-filler: the server runs 12000 (~20 min). The node caps an answer at 10,000 logs
# (since 2026-09-10) and the client halves a refused range, so a wide window is many calls.
RPC_WINDOW_BLOCKS=200000
# do not refetch the window more often than this
RPC_MIN_INTERVAL_S=600
# every fomo fill is routed through this contract; a wallet leg without it is not a trade
RPC_ROUTERS=0xb92fe925dc43a0ecde6c8b1a2709c170ec4fff4f
# where "who else traded this token just then" comes from during wallet resolution
RESOLVE_SOURCES=rpc,codex
TRACK_MAX_WALLETS_PER_PASS=25
CODEX_TRACK_PAGE_LIMIT=200
CODEX_TRACK_MAX_PAGES=3

# --- models ---
# how traders get scored: api | manual | auto (api when ANTHROPIC_API_KEY is set, else manual)
SCORER=auto
MANUAL_SCORES_PATH=pending_scores.json
SCORE_MODEL=claude-haiku-4-5
DEEP_MODEL=claude-sonnet-5

# --- optional ---
# (the telegram bot is configured above; subscribers live in the database, not here)

# --- the morning board on X (pipeline/board.py): where the html/png land; the browser playwright renders with
BOARD_DIR=
PLAYWRIGHT_BROWSERS_PATH=
X_HANDLE=FomoBrainRH

# --- what a chat may ask for (pipeline/follows.py, prefs.py, referrals.py, webhooks.py)
FOLLOW_FREE_MAX=3
FOLLOW_PRO_MAX=50
FOLLOW_MAX_PER_HOUR=30
PRO_REFERRAL_DAYS=7
PRO_REFERRAL_MAX_PER_MONTH=10
# a call-card is drawn and posted when the hour's peak reaches this multiple of the entry
CARD_MIN_X=2.0
# a Discord channel webhook that hears every alert, follow-up and card (leave empty for none)
DISCORD_WEBHOOK_URL=

# --- the gates on a push (pipeline/provenance.py waves, hot.py, safety.py, deployers.py, crews.py)
SEED_WAVE_MIN_WALLETS=5
SEED_WAVE_MAX_GAP_S=45
SEED_WAVE_MAX_USD=500
HOT_MIN_SPAN_S=180
HOT_MAX_SELL_RATIO=0.5
# a launch or burst wearing a listed ticker's name, or a name launched here already this
# fortnight, needs this much more heat / conviction to be told (LISTED_TICKERS_EXTRA adds names)
NAMESAKE_DAYS=14
NAMESAKE_BAR_MULT=1.5
# the cohort's dollars over the pool's last half hour (its own swaps, from the chain): measured
# on every push; under this share the push is held (0 = no gate). The 30-day study: under 3%
# the alerts lost, at 3% and over they paid
HOT_MIN_COHORT_SHARE=0.03
# a launch is pushed no sooner than this after the first trusted buy (provenance needs the fills)
TELEGRAM_LAUNCH_MIN_AGE_S=180
# the API's request threads wait this long on GeckoTerminal, then serve what is cached
GECKO_IMPATIENT_TIMEOUT_S=4
# a wallet that sold this much, this many times what it bought, in 7d is distributing: watch at most
DISTRIB_MIN_SOLD_USD=50000
DISTRIB_RATIO=5
PNL_GAP_USD=100000
HOT_YOUNG_S=1800
TELEGRAM_CLONE_HOURS=24
DEPLOYER_DAYS=7
DEPLOYER_MAX_BAD=1
CREW_DAYS=7
CREW_GAP_S=90
CREW_MIN_SHARED=4
CREW_MIN_SHARE=0.5
HOT_MIN_CREWS=2
