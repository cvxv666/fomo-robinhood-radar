---
import Base from '../../layouts/Base.astro';
import Meter from '../../components/Meter.astro';
import Search from '../../components/Search.astro';
import Ident from '../../components/Ident.astro';
import Chart from '../../components/Chart.astro';
import { getToken, getChart, usd, ago, amount, multiple } from '../../lib/api';
import { fomoToken } from '../../lib/links';

const { mint } = Astro.params;
const t = mint ? await getToken(mint) : null;
if (!t) return Astro.redirect(`/search?q=${encodeURIComponent(mint ?? '')}&miss=token`, 302);

const spans = ['24h', '7d', '30d'];
const spanParam = Astro.url.searchParams.get('span') ?? '7d';
const span = spans.includes(spanParam) ? spanParam : '7d';
const chart = t.is_quote ? null : await getChart(t.mint, span);

const name = t.symbol ?? `${t.mint.slice(0, 6)}…${t.mint.slice(-4)}`;

// Two questions, both answered from the chain and neither standing in for the other. Who is
// *buying* comes from the fills of the last two days; who *holds* is a balance read as of the
// last collection pass. A token can have a crowd of buyers and no holders — everyone who bought
// it sold it again — and the page says so rather than showing one number for both.
const buyers = t.buyers ?? [];
const trusted = buyers.filter((b) => (b.score ?? 0) >= 60);
const conv = t.buyer_conviction ?? 0;
// Two different questions, so two different numbers, each labelled by the question it answers.
const holderConviction = t.conviction ?? 0;
const hasFlow = buyers.length > 0;
const hasBook = t.holders.length > 0;

const desc = t.is_quote
  ? `${name} is a quote asset on Robinhood Chain — every swap passes through it, so holdings here are plumbing rather than conviction.`
  : hasFlow
    ? `${trusted.length} tracked wallets scoring 60+ have traded ${name} on Robinhood Chain, ${usd(t.bought_usd)} bought against ${usd(t.sold_usd)} sold.`
    : `No wallet we track holds or has traded ${name}.`;
---
<Base title={`${name} — who holds it on Robinhood Chain | FOMO Robinhood Radar`} description={desc}>
  <div class="pagehead">
    <Ident seed={t.mint} size={34} />
    <h1 style="font-size:clamp(28px,5vw,44px)">${name}</h1>
    {t.is_quote && <span class="badge drop">quote asset</span>}
    {t.seeded?.seeded && <span class="badge flag">seeded</span>}
    {t.sellable === 0 && <span class="badge flag">cannot be sold</span>}
    {!t.is_quote && hasFlow && !t.seeded?.seeded && <span class="badge follow">conviction {conv.toFixed(1)}</span>}
    {!t.is_quote && !hasFlow && !hasBook && <span class="badge tag">untracked</span>}
  </div>
  <p class="addr" style="margin-bottom:12px">{t.mint}</p>
  {!t.is_quote && (
    <p class="trade" style="margin-bottom:20px">
      <a class="btn go" href={fomoToken(t.mint, t.chain ?? 'robinhood')} rel="noopener">Buy on fomo →</a>
      <span class="hint">opens the token on fomo.family</span>
    </p>
  )}

  {t.sellable === 0 && (
    <p class="note flagged">
      <b>Nobody can sell this.</b> {t.sell_note ? `${t.sell_note[0].toUpperCase()}${t.sell_note.slice(1)}.` : ''} A
      token that lets you buy and not sell looks better on a tape than anything real — the price only
      goes one way — which is why it is checked before every launch and burst, and why this one is out
      of every feed however its numbers read.
    </p>
  )}
  {t.creator && t.creator.bad > 0 && (
    <p class="note flagged">
      <b>The creator's record says no.</b> The key that made this token, {t.creator.address.slice(0, 10)}…, made
      {t.creator.tokens} other{t.creator.tokens === 1 ? '' : 's'} this week and {t.creator.bad} went seeded, unsellable or dead
      ({t.creator.symbols.join(', ')}). A young token is not pushed on that record, whatever its numbers.
    </p>
  )}
  {t.creator && t.creator.bad === 0 && t.creator.tokens > 0 && (
    <p class="note">Made by {t.creator.address.slice(0, 10)}… {t.creator.via === 'factory' ? 'through the launch factory' : 'as a plain deployment'},
      their {t.creator.tokens + 1}{['st', 'nd', 'rd'][t.creator.tokens] ?? 'th'} token this week; none of the others went bad.</p>
  )}
  {t.seeded?.seeded && (
    <p class="note flagged">
      <b>This token was pushed into {t.seeded.wallets} trusted wallets rather than bought by them</b>
      {' — '}{[
        t.seeded.seed > 0 && `a wave of ${t.seeded.seed} one-apiece buys into a queue of wallets, seconds apart`,
        t.seeded.dust > 0 && `${t.seeded.dust} dust-sized fill${t.seeded.dust === 1 ? '' : 's'} through fomo`,
        t.seeded.direct > 0 && `${t.seeded.direct} swap${t.seeded.direct === 1 ? '' : 's'} sent to the router by an outside key with the wallet named as recipient`,
      ].filter(Boolean).join(' and ')}
      {t.seeded.first_ts && `, starting ${ago(t.seeded.first_ts)} ago`}. Anyone can do that to any
      address for a few dollars, and to a tracker it looks exactly like the cohort piling in. It is
      excluded from the signal, burst and launch feeds while the pattern holds, and the fills below
      are marked. The wallets named here did nothing.
    </p>
  )}

  {t.is_quote ? (
    <p class="note">
      <b>{name} is a quote asset.</b> Every trade on this chain is denominated in it, so a wallet
      holding it is holding cash, not a position. Feeds built on raw DEX data routinely rank it as
      the most-bought token on the chain — that is an artefact of how swaps are booked, not a signal.
    </p>
  ) : !hasFlow && !hasBook ? (
    <p class="note">
      <b>No wallet we track is in this name.</b> That is a real answer rather than a missing one:
      none of the scored traders on this list holds it, and none has traded it in the window. It may
      still be a fine token; there is simply no smart money here to read.
    </p>
  ) : (
    <>
      <dl class="strip">
        <div><dt>Buyers 60+</dt><dd class="g">{trusted.length}</dd></div>
        <div><dt>Conviction</dt><dd class="a">{conv.toFixed(1)}</dd></div>
        <div><dt>Bought {t.hours}h</dt><dd class="g">{usd(t.bought_usd)}</dd></div>
        <div><dt>Sold {t.hours}h</dt><dd class="c">{usd(t.sold_usd)}</dd></div>
        <div><dt>Fills</dt><dd>{t.flow.length}</dd></div>
        <div><dt>Liquidity</dt><dd>{usd(t.liquidity_usd)}</dd></div>
        {hasBook && <div><dt>Holders</dt><dd>{t.holders.length}</dd></div>}
        {hasBook && <div><dt>They hold</dt><dd class="g">{usd(t.cohort_value)}</dd></div>}
      </dl>

      {chart && chart.candles.length > 1 && (
        <Chart candles={chart.candles} span={span} base={`/token/${t.mint}`} />
      )}

      {hasFlow && (
        <div style="display:flex;align-items:center;gap:12px;margin-bottom:25px;flex-wrap:wrap">
          <span class="mono a" style="font-size:19px">{conv.toFixed(1)}</span>
          <Meter value={conv} max={32} />
          <span class="mono m" style="font-size:11px">conviction — the same measure the feed ranks by</span>
        </div>
      )}

      <div class="cols">
        <section>
          <h3 style="margin-bottom:4px">Who is buying it</h3>
          <p class="subhead">on-chain fills, last {t.hours}h · current to within fifteen minutes</p>
          {!hasFlow ? (
            <p class="empty">No fills in the window — this is a held position, not an active one.</p>
          ) : (
            <div class="scroll">
              <table>
                <thead><tr>
                  <th>Trader</th><th class="r">Score</th><th class="r">Bought</th>
                  <th class="r">Sold</th><th class="r">First</th>
                </tr></thead>
                <tbody>
                  {buyers.slice(0, 20).map((b) => (
                    <tr>
                      <td class="sym"><a href={`/trader/${b.handle ?? b.address}`}>{b.handle ?? b.address.slice(0, 10)}</a>{t.crews?.[b.address] && <span class="kind" title="buys the same tokens in the same minute as others in this crew: one opinion, counted once">crew {t.crews[b.address]}</span>}</td>
                      <td class={`r ${(b.score ?? 0) >= 60 ? 'g' : 'm'}`}>{b.score ?? '—'}</td>
                      <td class="r g">{b.bought ? usd(b.bought) : '—'}</td>
                      <td class="r c">{b.sold ? usd(b.sold) : '—'}</td>
                      <td class="r m">{ago(b.first_ts)}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}
          {t.first_trusted_buy && (
            <p class="note" style="margin-top:14px">
              First bought by a wallet scoring 60+ <b>{ago(t.first_trusted_buy)} ago</b>, and
              {' '}{t.trusted_buyers} of them have entered since.
            </p>
          )}
        </section>

        {(t.theses ?? []).length > 0 && (
          <section>
            <h3 style="margin-bottom:4px">What they said about it</h3>
            <p class="subhead">
              the traders' own words, loudest verdict first · only wallets we have scored
            </p>
            <ul class="theses">
              {t.theses.map((th) => (
                <li>
                  <div class="top">
                    <a class="handle" href={`/trader/${th.handle ?? th.address}`}>{th.handle ?? (th.address ?? '').slice(0, 10)}</a>
                    <span class={`badge ${(th.score ?? 0) >= 70 ? 'follow' : (th.score ?? 0) >= 40 ? 'watch' : 'drop'}`}>{th.score ?? '—'}</span>
                    {th.is_dev ? <span class="badge flag">dev</span> : null}
                    <span class="m mono">{th.first_seen_at ? `${ago(th.first_seen_at)} ago` : ''}</span>
                    {th.cost_usd ? <span class="m mono">in for {usd(th.cost_usd)}</span> : null}
                    {th.pnl_usd ? <span class={`mono ${th.pnl_usd >= 0 ? 'g' : 'c'}`}>{usd(th.pnl_usd)}</span> : null}
                  </div>
                  <p>{th.text}</p>
                </li>
              ))}
            </ul>
          </section>
        )}

        <section>
          <h3 style="margin-bottom:4px">Who holds it</h3>
          <p class="subhead">balances read off the chain · {holderConviction.toFixed(1)} conviction among holders</p>
          {!hasBook ? (
            <p class="note">
              <b>No tracked wallet is holding any of it right now.</b> Every wallet on this list has
              its balance read straight from the chain, so this is not a gap in the record — the
              buying on the left either has not settled into a position yet, or was sold back out.
            </p>
          ) : (
            <>
              <div class="scroll">
                <table>
                  <thead><tr>
                    <th>Trader</th><th class="r">Score</th><th class="r">Holds</th>
                    <th class="r">Worth</th><th class="r">Open PnL</th>
                  </tr></thead>
                  <tbody>
                    {t.holders.slice(0, 20).map((h) => (
                      <tr>
                        <td class="sym"><a href={`/trader/${h.handle ?? h.address}`}>{h.handle ?? h.address.slice(0, 10)}</a></td>
                        <td class={`r ${(h.score ?? 0) >= 60 ? 'g' : 'm'}`}>{h.score ?? '—'}</td>
                        <td class="r m">{amount(h.amount)}</td>
                        <td class="r">{usd(h.value ?? (h.cost !== null && h.pnl !== null ? h.cost + h.pnl : null))}</td>
                        <td class={`r ${h.pnl && h.pnl > 0 ? 'g' : h.pnl && h.pnl < 0 ? 'c' : 'm'}`}>{usd(h.pnl)}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
              <p class="note" style="margin-top:14px">
                {t.holders.length}{' '}tracked{' '}{t.holders.length === 1 ? 'wallet holds' : 'wallets hold'}
                {' '}<b>{usd(t.cohort_value)}</b> of this token between them.
                {t.cohort_pnl !== null && (
                  <> Where fomo also carries the position it reports <b>{usd(t.cohort_pnl)}</b> of
                  open profit on <b>{usd(t.cohort_cost)}</b> put in.</>
                )} A dash under <b>Open PnL</b> means the entry predates our tape, so the size is
                known and the profit is not.
              </p>
            </>
          )}
        </section>
      </div>

      {t.flow.length > 0 && (
        <>
          <div class="feedhead" style="margin-top:25px">
            <h2 style="font-size:22px">The tape</h2>
            <span class="feedmeta">every fill in the last {t.hours}h</span>
          </div>
          <div class="scroll">
            <table>
              <thead><tr><th>When</th><th>Side</th><th>Trader</th><th class="r">Score</th><th class="r">Size</th></tr></thead>
              <tbody>
                {t.flow.slice(0, 25).map((f) => (
                  <tr>
                    <td class="m">{ago(f.ts)}</td>
                    <td class={f.kind === 'dust' || f.kind === 'direct' || f.kind === 'seed' ? 'm' : f.side === 'buy' ? 'g' : 'c'}>
                      {f.side}{f.kind === 'dust' && <span class="kind" title="below this wallet's own size; not counted">dust</span>}{f.kind === 'direct' && <span class="kind" title="sent to the router by an outside key; not this wallet's trade">gift</span>}{f.kind === 'seed' && <span class="kind" title="one of a queue of one-apiece buys pushed into trusted wallets seconds apart; not this wallet's trade">seeded</span>}
                    </td>
                    <td class="sym">{f.handle ?? '—'}</td>
                    <td class={`r ${(f.score ?? 0) >= 60 ? 'g' : 'm'}`}>{f.score ?? '—'}</td>
                    <td class="r">{usd(f.usd)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </>
      )}
    </>
  )}

  <div style="margin-top:25px"><Search /></div>

<style>
  .note.flagged { border-color: var(--crimson); }
  .kind {
    font-family: var(--mono); font-size: 9.5px; letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--crimson); border: 1px dashed var(--crimson); border-radius: 9999px;
    padding: 0 6px; margin-left: 6px; vertical-align: 1px;
  }
</style>

  <style>
    .feedhead {
      display: flex; align-items: baseline; gap: 14px; flex-wrap: wrap;
      border-top: 1px solid #ffffff; padding-top: 12px; margin-bottom: 14px;
    }
    .feedmeta {
      font-family: "JetBrains Mono", ui-monospace, monospace; font-size: 10.5px;
      letter-spacing: 0.06em; color: #606060; margin-left: auto;
    }
  </style>
</Base>
