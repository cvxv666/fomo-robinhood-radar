---
import og from '../assets/og.png';
import Logo from '../components/Logo.astro';
import { fomoHome } from '../lib/links';
import '../styles/tokens.css';

interface Props {
  title: string;
  description: string;
  /** Which nav item is current */
  section?: 'signals' | 'bursts' | 'fresh' | 'exits' | 'leaderboard' | 'record' | 'about' | 'pro' | null;
  /** Keep this page out of search results (thin or address-specific pages) */
  noindex?: boolean;
}
const { title, description, section = null, noindex = false } = Astro.props;
const base = Astro.site ?? new URL('https://fomoradar.app');
const bot = (import.meta.env.PUBLIC_TELEGRAM_BOT ?? 'fomoradarRH_bot').trim().replace(/^@/, '');
const canonical = new URL(Astro.url.pathname, base).href;
// Crawlers need an absolute URL and a raster: Telegram, Twitter and Slack all refuse SVG.
// The file is written by assets/brand/make_brand.py from the same mark as everything else, and
// imported rather than served from public/ so the build puts a content hash in its name. Telegram
// caches a preview image by URL and nothing short of a new URL dislodges it: a regenerated file at
// the old address kept showing the old picture even after @WebpageBot said it had refreshed.
const ogImage = new URL(og.src, base).href;
// No repository yet, and a link to github.com itself is worse than no link at all.
const repo = import.meta.env.PUBLIC_REPO_URL ?? '';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex" />}

  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="FOMO Robinhood Radar" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:type" content="image/png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="FOMO Robinhood Radar" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <meta name="theme-color" content="#000000" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;700&family=JetBrains+Mono:wght@400;500&display=swap" />
</head>
<body>
  <div class="wrap">
    <header class="masthead">
      <a class="brand" href="/">
        <Logo size={30} />
        <span class="wordmark">FOMO&nbsp;<i>ROBINHOOD</i>&nbsp;RADAR</span>
      </a>
      <nav class="tabs">
        <a href="/" aria-current={section === 'signals' ? 'page' : undefined}>signals</a>
        <a href="/hot" aria-current={section === 'bursts' ? 'page' : undefined}>bursts</a>
        <a href="/fresh" aria-current={section === 'fresh' ? 'page' : undefined}>fresh</a>
        <a href="/exits" aria-current={section === 'exits' ? 'page' : undefined}>exits</a>
        <a href="/leaderboard" aria-current={section === 'leaderboard' ? 'page' : undefined}>leaderboard</a>
        <a href="/record" aria-current={section === 'record' ? 'page' : undefined}>record</a>
        <a href="/about" aria-current={section === 'about' ? 'page' : undefined}>about</a>
        <a href="/pro" aria-current={section === 'pro' ? 'page' : undefined}>pro</a>
      </nav>
      <a class="tg" href={`https://t.me/${bot}`} rel="noopener" aria-label="Open the Telegram bot">
        <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path fill="currentColor" d="M21.9 4.3 18.7 19.6c-.2 1-.9 1.3-1.7.8l-4.8-3.5-2.3 2.2c-.3.3-.5.5-1 .5l.4-4.8 8.8-8c.4-.3-.1-.5-.6-.2L8.6 13.4 3.9 12c-1-.3-1-1 .2-1.5L20.6 4c.9-.3 1.6.2 1.3.3z"/></svg>
        <span>Telegram bot</span>
      </a>
    </header>

    <main>
      <slot />
    </main>

    <footer class="foot">
      <span>FOMO Robinhood Radar · research, not financial advice</span>
      <span>Robinhood Chain · 4663</span>
      <a href={fomoHome()} rel="noopener">trade on fomo.family</a>
      <a href="/docs">API</a>
      {repo && <a href={repo}>source</a>}
    </footer>
  </div>
</body>
</html>
